{
  "name": "@dugstack/drizzle-migrator-cli",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": "git+https://github.com/dugstack/drizzle-migrator.git",
  "bugs": "https://github.com/dugstack/drizzle-migrator/issues",
  "homepage": "https://github.com/dugstack/drizzle-migrator#readme",
  "engines": {
    "node": ">=20"
  },
  "description": "Executable `drizzle-migrator` command for @dugstack/drizzle-migrator: owns the command dispatch, flag parsing, prompts, usage, bundled agent skill, config discovery, migration auto-discovery, and Postgres connection wiring.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "drizzle-migrator": "./dist/bin.js"
  },
  "files": ["dist", "skills"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run test/pg.integration.test.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dugstack/drizzle-migrator": "^0.1.0",
    "drizzle-orm": "0.45.2",
    "jiti": "^2.6.0",
    "pg": "^8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10",
    "@types/node": "^22",
    "@types/pg": "^8",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
