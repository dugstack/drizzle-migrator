{
  "name": "@dugstack/drizzle-migrator",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dugstack/drizzle-migrator.git"
  },
  "bugs": "https://github.com/dugstack/drizzle-migrator/issues",
  "homepage": "https://github.com/dugstack/drizzle-migrator#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js"
    },
    "./mysql": {
      "types": "./dist/mysql/index.d.ts",
      "import": "./dist/mysql/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run test/pg.integration.test.ts test/mysql.integration.test.ts test/sqlite.integration.test.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0",
    "drizzle-orm": "0.45.2",
    "mysql2": ">=3.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/mysql": "^10.28.0",
    "@testcontainers/postgresql": "^10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/pg": "^8",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "0.45.2",
    "mysql2": "^3.24.5",
    "pg": "^8",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
